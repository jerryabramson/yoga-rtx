#!/usr/bin/env python3
"""Change only the laptop panel's brightness (Plasma/KWin), leaving external
displays alone. Plasma's own brightness keys adjust every display.

Usage: panel-brightness up|down [STEP]   (default step 5%)
Goes through KWin (kscreen-doctor), so Plasma's sliders stay in sync, and
shows the normal Plasma brightness OSD.
"""
import json
import shutil
import subprocess
import sys

OUTPUT = "eDP-1"
MIN = 1  # never go fully black


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("up", "down"):
        sys.exit(__doc__)
    step = int(sys.argv[2]) if len(sys.argv) > 2 else 5
    cfg = json.loads(subprocess.run(["kscreen-doctor", "-j"], capture_output=True,
                                    text=True, check=True).stdout)
    out = next(o for o in cfg["outputs"] if o.get("name") == OUTPUT)
    cur = round(out["brightness"] * 100)
    new = min(100, cur + step) if sys.argv[1] == "up" else max(MIN, cur - step)
    subprocess.run(["kscreen-doctor", f"output.{OUTPUT}.brightness.{new}"],
                   capture_output=True, check=True)
    qdbus = shutil.which("qdbus6") or shutil.which("qdbus")
    if qdbus:
        subprocess.run([qdbus, "org.kde.plasmashell", "/org/kde/osdService",
                        "org.kde.osdService.brightnessChanged", str(new)],
                       capture_output=True)


if __name__ == "__main__":
    main()
